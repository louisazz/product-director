{
  "name": "product-director-agent",
  "version": "0.1.0",
  "description": "Lazy — A local AI product director for WeChat-style product judgment.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc",
    "build:web": "vite build",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "verify:tools": "tsx src/dev/verify-tools.ts",
    "verify:streaming": "tsx src/dev/verify-answer-streaming.ts",
    "smoke:permissions": "tsx src/dev/smoke-permissions.ts",
    "verify:session": "tsx src/dev/verify-session.ts",
    "verify:projects": "tsx src/dev/verify-projects.ts",
    "verify:semantic": "tsx src/dev/verify-semantic.ts",
    "verify:vision": "tsx src/dev/verify-vision.ts",
    "verify:attachments": "tsx src/dev/verify-attachments.ts",
    "verify:codeblock": "tsx src/dev/verify-codeblock.ts",
    "verify:imagedim": "tsx src/dev/verify-image-dimensions.ts",
    "verify:skilldirective": "tsx src/dev/verify-skill-directive.ts",
    "probe:agent": "tsx src/dev/probe-agent.ts",
    "web": "tsx src/web/server.ts",
    "start:web": "npm run web",
    "verify": "npm run typecheck && npm run build && npm run verify:tools && npm run verify:session && npm run verify:projects && npm run verify:streaming && npm run verify:codeblock && npm run verify:imagedim && npm run verify:skilldirective && npm run verify:vision && npm run verify:attachments && npm run smoke:permissions"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.19",
    "@assistant-ui/react-lexical": "0.2.12",
    "@lexical/react": "0.49.0",
    "@lexical/utils": "0.49.0",
    "@napi-rs/canvas": "^1.0.9",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^17.4.2",
    "lexical": "0.49.0",
    "lucide-react": "^1.28.0",
    "openai": "^6.38.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
